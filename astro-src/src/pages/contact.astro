---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import HeroSection from "../components/Sections/HeroSection.astro";
import ProgramSection from "../components/ProgramSection.astro";
import NewsSection from "../components/NewsSection.astro";
import CommunitySection from "../components/CommunitySection.astro";
import TestimonialsSection from "../components/TestimonialsSection.astro";
import ContactSection from "../components/ContactSection.astro";
import JoinSection from "../components/JoinSection.astro";

import Layout from "../layouts/Layout.astro";
import ManagementJoin from "../components/ManagementJoin.astro";

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<Layout pageKey="home">
  <Header />
  <div class="container">
    <section class="contact-us py-5">
      <div class="container">
        <!-- Page Heading -->
        <div class="row mb-5">
          <div class="col-lg-8 mx-auto text-center">
            <h1 class="display-5 fw-bold mb-3">Contact Us</h1>

            <p class="lead text-body-secondary mb-0">
              We welcome your questions, suggestions, and feedback. If you are
              an Ex-Serviceman, a family member, or someone interested in
              supporting our cause, please feel free to get in touch with us.
            </p>
          </div>
        </div>

        <div class="row g-4 g-lg-5">
          <!-- Contact Information -->
          <div class="col-lg-5">
            <h2 class="h3 fw-bold mb-3">Get in Touch</h2>

            <p class="text-body-secondary mb-4">
              Voice of Ex-Servicemen is a charitable society working for the
              rights, welfare, dignity and legitimate interests of
              Ex-Servicemen.
            </p>

            <!-- Address -->
            <div class="d-flex gap-3 mb-4">
              <div
                class="flex-shrink-0 bg-primary-subtle text-primary
                   rounded-circle d-flex align-items-center
                   justify-content-center"
                style="width: 46px; height: 46px;"
              >
                <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
              </div>

              <div>
                <h3 class="h6 fw-bold mb-1">Address</h3>
                <p class="text-body-secondary mb-0">
                  Voice of Ex-Servicemen<br />
                  59, Vipin Garden Extension Dwarka, New Delhi-110059<br />
                  India
                </p>
              </div>
            </div>

            <!-- Email -->
            <div class="d-flex gap-3 mb-4">
              <div
                class="flex-shrink-0 bg-primary-subtle text-primary
                   rounded-circle d-flex align-items-center
                   justify-content-center"
                style="width: 46px; height: 46px;"
              >
                <i class="fa-solid fa-envelope" aria-hidden="true"></i>
              </div>

              <div>
                <h3 class="h6 fw-bold mb-1">Email</h3>
                <p class="mb-0">
                  <a
                    href="mailto:info@voiceofexservicemen.in"
                    class="text-decoration-none"
                  >
                    info@voiceofexservicemen.in
                  </a>
                </p>
              </div>
            </div>

            <!-- Phone -->
            <div class="d-flex gap-3 mb-4">
              <div
                class="flex-shrink-0 bg-primary-subtle text-primary
                   rounded-circle d-flex align-items-center
                   justify-content-center"
                style="width: 46px; height: 46px;"
              >
                <i class="fa-solid fa-phone" aria-hidden="true"></i>
              </div>

              <div>
                <h3 class="h6 fw-bold mb-1">Phone</h3>
                <p class="text-body-secondary mb-0">9897468767</p>
              </div>
            </div>

            <!-- Working Hours -->
            <div class="d-flex gap-3 mb-4">
              <div
                class="flex-shrink-0 bg-primary-subtle text-primary
                   rounded-circle d-flex align-items-center
                   justify-content-center"
                style="width: 46px; height: 46px;"
              >
                <i class="fa-solid fa-clock" aria-hidden="true"></i>
              </div>

              <div>
                <h3 class="h6 fw-bold mb-1">Office Hours</h3>
                <p class="text-body-secondary mb-0">
                  Monday to Saturday<br />
                  9:00 AM to 6:00 PM (IST)
                </p>
              </div>
            </div>

            <div class="alert alert-light border mt-4">
              <div class="d-flex gap-2">
                <i
                  class="fa-solid fa-circle-info text-primary mt-1"
                  aria-hidden="true"></i>

                <small class="text-body-secondary">
                  Please do not share passwords, OTPs, UPI PINs, ATM PINs, card
                  details, or other confidential financial information with us.
                </small>
              </div>
            </div>
          </div>

          <!-- Contact Form -->
          <div class="col-lg-7">
            <div class="card border-0 shadow-sm">
              <div class="card-body p-4 p-md-5">
                <h2 class="h3 fw-bold mb-2">Send Us a Message</h2>

                <p class="text-body-secondary mb-4">
                  Please fill out the form below. We will try to respond to your
                  enquiry as soon as possible.
                </p>

                <form method="POST" action="/api/contact">
                  <!-- Name -->
                  <div class="mb-3">
                    <label for="name" class="form-label fw-semibold">
                      Full Name <span class="text-danger">*</span>
                    </label>

                    <input
                      type="text"
                      class="form-control"
                      id="name"
                      name="name"
                      placeholder="Enter your full name"
                      autocomplete="name"
                      required
                    />
                  </div>

                  <!-- Email -->
                  <div class="mb-3">
                    <label for="email" class="form-label fw-semibold">
                      Email Address <span class="text-danger">*</span>
                    </label>

                    <input
                      type="email"
                      class="form-control"
                      id="email"
                      name="email"
                      placeholder="name@example.com"
                      autocomplete="email"
                      required
                    />
                  </div>

                  <!-- Phone -->
                  <div class="mb-3">
                    <label for="phone" class="form-label fw-semibold">
                      Phone Number
                    </label>

                    <input
                      type="tel"
                      class="form-control"
                      id="phone"
                      name="phone"
                      placeholder="Enter your phone number"
                      autocomplete="tel"
                    />
                  </div>

                  <!-- Subject -->
                  <div class="mb-3">
                    <label for="subject" class="form-label fw-semibold">
                      Subject <span class="text-danger">*</span>
                    </label>

                    <select
                      class="form-select"
                      id="subject"
                      name="subject"
                      required
                    >
                      <option value="" selected disabled>
                        Select a subject
                      </option>

                      <option value="general"> General Enquiry </option>

                      <option value="ex-servicemen-welfare">
                        Ex-Servicemen Welfare
                      </option>

                      <option value="rights-entitlements">
                        Rights &amp; Entitlements
                      </option>

                      <option value="membership"> Membership </option>

                      <option value="donation"> Donation </option>

                      <option value="grievance"> Grievance / Complaint </option>

                      <option value="suggestion"> Suggestion </option>

                      <option value="other"> Other </option>
                    </select>
                  </div>

                  <!-- Message -->
                  <div class="mb-4">
                    <label for="message" class="form-label fw-semibold">
                      Message <span class="text-danger">*</span>
                    </label>

                    <textarea
                      class="form-control"
                      id="message"
                      name="message"
                      rows="6"
                      placeholder="Write your message here..."
                      required></textarea>
                  </div>

                  <!-- Consent -->
                  <div class="form-check mb-4">
                    <input
                      class="form-check-input"
                      type="checkbox"
                      id="consent"
                      name="consent"
                      value="yes"
                      required
                    />

                    <label class="form-check-label small" for="consent">
                      I agree that Voice of Ex-Servicemen may use the
                      information provided above to respond to my enquiry.
                    </label>
                  </div>

                  <!-- Submit -->
                  <button type="submit" class="btn btn-primary px-4">
                    <i class="fa-solid fa-paper-plane me-2" aria-hidden="true"
                    ></i>
                    Send Message
                  </button>
                </form>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
    <ManagementJoin />
  </div>
  <Footer />
</Layout>
