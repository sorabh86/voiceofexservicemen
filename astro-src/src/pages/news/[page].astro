---
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import NewsListing from '../../components/NewsListing.astro';
import Layout from '../../layouts/Layout.astro';
import newsData from '../../data/newsData.json';

const pageSize = 2;

export function getStaticPaths() {
	const pageCount = Math.ceil(newsData.length / pageSize);

	return Array.from({ length: pageCount - 1 }, (_, index) => ({
		params: { page: String(index + 2) },
		props: { currentPage: index + 2, pageCount },
	}));
}

const { currentPage, pageCount } = Astro.props;
---

<Layout pageKey="news">
	<Header />
	<main class="news-page">
		<NewsListing posts={newsData} currentPage={currentPage} pageCount={pageCount} />
	</main>
	<Footer />
</Layout>
