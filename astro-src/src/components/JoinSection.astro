<!-- Join / Signup -->
<section id="join" class="mb-5">
  <div class="row g-4 align-items-center">
    <div class="col-lg-6">
      <h3 class="fw-bold">Become a Member</h3>
      <p class="text-muted">
        Join our community to access programs, events and peer support.
      </p>
      <a class="btn btn-success" href="#">Learn More</a>
    </div>
    <div class="col-lg-6">
      <div class="card p-3">
        <form>
          <div class="mb-2">
            <label class="form-label small">Name</label>
            <input class="form-control" placeholder="Your name" />
          </div>
          <div class="mb-2">
            <label class="form-label small">Email</label>
            <input class="form-control" placeholder="you@example.com" />
          </div>
          <div class="d-grid">
            <button class="btn btn-success">Sign Up</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>
