<!-- Contact -->
<section id="contact" class="mb-5">
  <h2 class="h3 fw-bold mb-4">Get In Touch</h2>
  <div class="row g-4">
    <div class="col-md-6">
      <div class="card p-3">
        <form>
          <div class="mb-2">
            <input class="form-control" placeholder="Name" />
          </div>
          <div class="mb-2">
            <input class="form-control" placeholder="Email" />
          </div>
          <div class="mb-2">
            <textarea class="form-control" rows="4" placeholder="Message"
            ></textarea>
          </div>
          <div class="d-grid">
            <button class="btn btn-success">Contact</button>
          </div>
        </form>
      </div>
    </div>
    <div class="col-md-6">
      <div class="ratio ratio-16x9 rounded overflow-hidden shadow-sm">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"></iframe>
      </div>
    </div>
  </div>
</section>
