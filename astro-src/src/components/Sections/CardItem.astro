---
const {title, description, image} = Astro.props || {
  title: "Default Title",
  description: "Default description for the card.",
  image: "assets/default.jpg"
};
---

<div class="row g-3">
    <div class="col-md-4">
        <div class="card h-100">
            <img src={image} class="card-img-top" alt={title+' Image'} />
            <div class="card-body">
                <h5 class="card-title">{title}</h5>
                <p class="card-text small text-muted" set:html={description}>
                </p>
            </div>
        </div>
    </div>
</div>
